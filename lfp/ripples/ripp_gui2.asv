function hFig = ripp_gui2(basepath, varargin)
% RIPP_GUI2  Interactive SWR viewer: raw LFP, RS firing-order raster, spike density.
%
%   hFig = RIPP_GUI2(basepath, varargin)
%
%   SUMMARY:
%       Loads SWR detection results and spike data from disk, then
%       displays a 3-panel interactive view of each event:
%           1. Raw LFP (ripple channel)
%           2. Spike raster (RS units only), sorted on every navigation
%              step with the following priority:
%                 Group 1 (bottom): units that fire within the ripple
%                   [stT, enT], ordered by their first within-ripple spike.
%                 Group 2 (middle): units that fire in the display window
%                   but outside the ripple, ordered by first window spike.
%                 Group 3 (top): silent units.
%              Burst spikes are overlaid in red.
%           3. Spike-density strip: normalized KDE [0, 1] of RS spikes
%              within the ripple, evaluated across the full window so the
%              curve tapers naturally to zero in both flanks. A gray patch
%              marks the ripple extent. A dashed blue line marks the SWR
%              peak. An orange triangle marks the center of mass (CoM),
%              defined as the mean spike time within the ripple.
%
%   CONTROLS:
%       [<] [>] Buttons or Left / Right Arrow Keys (also 'a' / 'd').
%       Event index edit box — jump to a specific event.
%       Win edit box         — update the display half-window [s].
%       Export button        — save a publication-quality vector figure
%                              (calls ripp_gui2_export).
%
%   INPUTS:
%       basepath  - (Char) Session directory. Must contain:
%                       <basename>.session.mat
%                       <basename>.ripp.mat
%                       <basename>.spikes.mat
%                       <basename>.units.mat
%                       <basename>.brst.mat
%                       <basename>.lfp or .dat (binary)
%       varargin  - Parameter/Value pairs:
%           'winPlot'  - (Num) Window half-width around peak [s]. {0.5}
%
%   OUTPUTS:
%       hFig      - (Handle) Figure handle.
%
%   DEPENDENCIES:
%       basepaths2vars, binary_load, plot_raster, ripp_gui2_export.
%
%   HISTORY:
%       Created: 24 Mar 2026

%% ========================================================================
%  ARGUMENTS
%  ========================================================================

p = inputParser;
addRequired(p,  'basepath', @ischar);
addParameter(p, 'winPlot',  0.5, @isnumeric);

parse(p, basepath, varargin{:});
winPlot = p.Results.winPlot;


%% ========================================================================
%  DATA LOADING
%  ========================================================================

[~, basename] = fileparts(basepath);

vars = {'ripp', 'spikes', 'brst', 'units', 'session'};
v    = basepaths2vars('basepaths', {basepath}, 'vars', vars);
ripp    = v.ripp;
spikes  = v.spikes;
units   = v.units;
brst    = v.brst;
session = v.session;

% Ripple channel (used in binary_load)
nChans = session.extracellular.nChannels;   % total channels in binary
if isfield(session, 'channelTags') && isfield(session.channelTags, 'Ripple')
    rippCh = session.channelTags.Ripple(2);
else
    rippCh = 1;
    warning('[RIPP_GUI2]: Ripple channel not found in session. Defaulting to ch 1.');
end

% Voltage conversion factor (Intan vs TDT)
if round(session.extracellular.sr) == 24414
    bit2uv = 1;       % TDT / Tucker-Davis
else
    bit2uv = 0.195;   % Intan
end

flgDat = true;
if flgDat
    fname = fullfile(basepath, [basename, '.dat']);
    fs    = session.extracellular.sr;       % broadband sampling rate [Hz]
else
    fname = fullfile(basepath, [basename, '.lfp']);
    fs    = session.extracellular.srLfp;    % LFP sampling rate [Hz]
end


%% ========================================================================
%  PRE-PROCESSING
%  ========================================================================

% --- RS Unit Spike Times ---
% spikes.times and brst.spktimes are both cell arrays of spike times [s],
% indexed by unit. brst.spktimes contains burst spikes only.
idxRS     = units.type == 'RS';
spktimes  = spikes.times(:);    % ensure column cell array
spktimes  = spktimes(idxRS);
brstTimes = brst.spktimes(:);   % ensure column cell array
brstTimes = brstTimes(idxRS);

% --- Raw LFP (ripple channel, full recording) ---
% Load from time 0 so timestamps align with the absolute times in ripp.times.
lfp = double(binary_load(fname, 'duration', Inf, 'fs', fs, ...
    'nCh', nChans, 'start', 0, 'ch', rippCh, 'downsample', 1, ...
    'bit2uv', bit2uv));

if size(lfp, 2) > 1
    lfp = mean(lfp, 2);     % average if multiple channels returned
end
lfp = lfp(:);               % ensure column vector

% Absolute time axis
timestamps = (0 : length(lfp) - 1)' / fs;

% Global y-limits for the LFP panel (robust to outliers)
yLimRaw = prctile(lfp, [0.1, 99.9]);


%% ========================================================================
%  GUI SETUP
%  ========================================================================

hFig = figure('Name', [basename, ' — Ripple GUI2'], 'NumberTitle', 'off', ...
    'Units', 'normalized', 'Position', [0.05 0.05 0.9 0.9], ...
    'KeyPressFcn', @onKeyPress);

% ---- Pack all GUI state into UserData ----
guiData            = struct();
guiData.basepath   = basepath;
guiData.basename   = basename;
guiData.rippTimes  = ripp.times;       % [N x 2] start / end times (s)
guiData.peakTimes  = ripp.peakTime;    % [N x 1] peak times (s)
guiData.lfp        = lfp;
guiData.timestamps = timestamps;
guiData.fs         = fs;
guiData.winPlot    = winPlot;
guiData.yLimRaw    = yLimRaw;
guiData.spktimes   = spktimes;         % RS unit spike times  {nRS x 1}
guiData.brstTimes  = brstTimes;        % RS burst spike times {nRS x 1}
guiData.currIdx    = 1;
guiData.nEvents    = size(ripp.times, 1);
guiData.renderData = struct();         % populated by updatePlot; used by export

% ---- Layout: top = navigation bar, bottom = data panels ----
guiData.grid             = uigridlayout(hFig, [2, 1]);
guiData.grid.RowHeight   = {44, '1x'};
guiData.grid.ColumnWidth = {'1x'};

% ---- Navigation Panel (top row) ----
hPanNav            = uipanel(guiData.grid);
hPanNav.BorderType = 'none';

hFlow = uiflowcontainer('v0', 'Parent', hPanNav, ...
    'FlowDirection', 'LeftToRight', 'Margin', 6);

% Prev / Next buttons
hBtnPrev = uicontrol('Parent', hFlow, 'Style', 'pushbutton', 'String', '<', ...
    'Callback', @(~, ~) navStep(-1));
set(hBtnPrev, 'WidthLimits', [28 28]);

% Event index edit box
guiData.hEditIdx = uicontrol('Parent', hFlow, 'Style', 'edit', ...
    'String', '1', 'Callback', @onEditIdx, 'BackgroundColor', 'w');
set(guiData.hEditIdx, 'WidthLimits', [50 60]);

% Total event count label
guiData.hTxtTotal = uicontrol('Parent', hFlow, 'Style', 'text', ...
    'String', sprintf('/ %d', guiData.nEvents), 'HorizontalAlignment', 'left');
set(guiData.hTxtTotal, 'WidthLimits', [60 80]);

hBtnNext = uicontrol('Parent', hFlow, 'Style', 'pushbutton', 'String', '>', ...
    'Callback', @(~, ~) navStep(1));
set(hBtnNext, 'WidthLimits', [28 28]);

% Spacer
hSpc1 = uicontrol('Parent', hFlow, 'Style', 'text', 'String', '');
set(hSpc1, 'WidthLimits', [16 16]);

% winPlot label + edit box
hTxtWin = uicontrol('Parent', hFlow, 'Style', 'text', 'String', 'Win (s):', ...
    'HorizontalAlignment', 'right');
set(hTxtWin, 'WidthLimits', [50 50]);
guiData.hEditWin = uicontrol('Parent', hFlow, 'Style', 'edit', ...
    'String', num2str(winPlot), 'Callback', @onEditWin, 'BackgroundColor', 'w');
set(guiData.hEditWin, 'WidthLimits', [45 55]);

% Spacer
hSpc2 = uicontrol('Parent', hFlow, 'Style', 'text', 'String', '');
set(hSpc2, 'WidthLimits', [16 16]);

% Peak time info label
guiData.hTxtTime = uicontrol('Parent', hFlow, 'Style', 'text', ...
    'String', 't = 0.000 s', 'HorizontalAlignment', 'left');
set(guiData.hTxtTime, 'WidthLimits', [130 160]);

% Spacer
hSpc3 = uicontrol('Parent', hFlow, 'Style', 'text', 'String', '');
set(hSpc3, 'WidthLimits', [16 16]);

% Export button
hBtnExport = uicontrol('Parent', hFlow, 'Style', 'pushbutton', 'String', 'Export', ...
    'Callback', @(~, ~) ripp_gui2_export(hFig));
set(hBtnExport, 'WidthLimits', [60 70]);

% ---- Plot Panel (bottom row) ----
% Five virtual rows give a 2 : 2 : 1 tile height ratio:
%   Rows 1-2  → hAxRaw  (LFP)
%   Rows 3-4  → hAxSpk  (Raster)
%   Row  5    → hAxMua  (spike-density strip — thin)
hPanPlot            = uipanel(guiData.grid);
hPanPlot.BorderType = 'none';
guiData.tiled       = tiledlayout(hPanPlot, 5, 1, ...
    'TileSpacing', 'tight', 'Padding', 'compact');

guiData.hAxRaw = nexttile(guiData.tiled, 1, [2, 1]);   % rows 1-2
guiData.hAxSpk = nexttile(guiData.tiled, 3, [2, 1]);   % rows 3-4
guiData.hAxMua = nexttile(guiData.tiled, 5, [1, 1]);   % row  5

linkaxes([guiData.hAxRaw, guiData.hAxSpk, guiData.hAxMua], 'x');

% ---- Store State & Draw ----
hFig.UserData = guiData;

if guiData.nEvents > 0
    updatePlot(hFig);
else
    title(guiData.hAxRaw, 'No Ripples Detected');
end


%% ========================================================================
%  CALLBACKS
%  ========================================================================

    % -----------------------------------------------------------------
    % Key Press: arrow keys or a / d to navigate
    % -----------------------------------------------------------------
    function onKeyPress(~, event)
        switch event.Key
            case {'rightarrow', 'd'},  navStep(1);
            case {'leftarrow',  'a'},  navStep(-1);
        end
    end

    % -----------------------------------------------------------------
    % Navigate: advance or retreat by one event
    % -----------------------------------------------------------------
    function navStep(step)
        data   = hFig.UserData;
        newIdx = data.currIdx + step;
        if newIdx >= 1 && newIdx <= data.nEvents
            data.currIdx  = newIdx;
            hFig.UserData = data;
            updatePlot(hFig);
        end
    end

    % -----------------------------------------------------------------
    % Event Index Edit Box: jump to a specific event
    % -----------------------------------------------------------------
    function onEditIdx(src, ~)
        data = hFig.UserData;
        val  = str2double(src.String);
        if isnan(val) || val < 1 || val > data.nEvents || val ~= round(val)
            src.String = num2str(data.currIdx);   % restore valid value
            return;
        end
        data.currIdx  = val;
        hFig.UserData = data;
        updatePlot(hFig);
    end

    % -----------------------------------------------------------------
    % Window Edit Box: update the display half-window and redraw
    % -----------------------------------------------------------------
    function onEditWin(src, ~)
        data = hFig.UserData;
        val  = str2double(src.String);
        if isnan(val) || val <= 0
            src.String = num2str(data.winPlot);   % restore valid value
            return;
        end
        data.winPlot  = val;
        hFig.UserData = data;
        updatePlot(hFig);
    end

    % -----------------------------------------------------------------
    % Update Plot: redraw all three panels for the current event index
    % -----------------------------------------------------------------
    function updatePlot(figH)
        data = figH.UserData;
        idx  = data.currIdx;

        % Safety clamp
        idx          = max(1, min(idx, data.nEvents));
        data.currIdx = idx;

        % Sync controls
        data.hEditIdx.String  = num2str(idx);
        data.hTxtTotal.String = sprintf('/ %d', data.nEvents);

        % Early exit if session has no events
        if data.nEvents == 0
            cla(data.hAxRaw);  cla(data.hAxSpk);  cla(data.hAxMua);
            title(data.hAxRaw, 'No Ripples');
            return;
        end

        % Event timing
        pkT = data.peakTimes(idx);
        stT = data.rippTimes(idx, 1);
        enT = data.rippTimes(idx, 2);
        data.hTxtTime.String = sprintf('Peak t = %.3f s', pkT);

        % Display window
        winStart = pkT - data.winPlot;
        winEnd   = pkT + data.winPlot;

        % LFP sample range
        sampleStart = max(1, round(winStart * data.fs));
        sampleEnd   = min(length(data.lfp), round(winEnd * data.fs));
        rangeIdx    = sampleStart : sampleEnd;
        tVec        = data.timestamps(rangeIdx);
        lfpSeg      = data.lfp(rangeIdx);

        if isempty(tVec), return; end


        % --- Panel 1: Raw LFP ---

        cla(data.hAxRaw);
        plot(data.hAxRaw, tVec, lfpSeg, 'k');
        xline(data.hAxRaw, [stT, pkT, enT], '--b');
        ylabel(data.hAxRaw, 'LFP (\muV)');
        grid(data.hAxRaw, 'on');
        xlim(data.hAxRaw, [winStart, winEnd]);
        ylim(data.hAxRaw, data.yLimRaw);


        % --- Panel 2: Raster (firing-order sorted, ripple-priority) ---

        cla(data.hAxSpk);

        % Prune each unit's spikes to the display window
        spkWin  = cellfun(@(s) s(s >= winStart & s <= winEnd), ...
            data.spktimes,  'UniformOutput', false);
        brstWin = cellfun(@(s) s(s >= winStart & s <= winEnd), ...
            data.brstTimes, 'UniformOutput', false);

        % Sort: ripple-firing units first (by first within-ripple spike),
        % then window-only units (by first window spike), then silent units
        sortOrder  = firingOrderSort(spkWin, stT, enT);
        spkSorted  = spkWin(sortOrder);
        brstSorted = brstWin(sortOrder);

        % All spikes — black
        plot_raster(spkSorted, 'hAx', data.hAxSpk, ...
            'xLim', [winStart, winEnd], 'flgLbls', false, 'clr', [0 0 0]);

        % Burst spikes overlaid — red (skip if none in window)
        if any(~cellfun(@isempty, brstSorted))
            plot_raster(brstSorted, 'hAx', data.hAxSpk, ...
                'xLim', [winStart, winEnd], 'flgLbls', false, 'clr', [1 0 0]);
        end

        xline(data.hAxSpk, [stT, pkT, enT], '--b');
        ylabel(data.hAxSpk, 'Units (RS)');


        % --- Panel 3: Spike-Density Strip ---

        cla(data.hAxMua);

        % Spikes within the ripple only — these define the KDE and CoM
        allSpks  = sort(vertcat(spkWin{:}));
        rippSpks = allSpks(allSpks >= stT & allSpks <= enT);

        % Normalized KDE [0, 1].
        % Evaluated over the full display window; because all spikes are
        % confined within [stT, enT], the curve tapers to near-zero in
        % both flanks without any boundary correction.
        kdePts = [];
        muaKDE = [];
        if length(rippSpks) > 1
            kdePts    = linspace(winStart, winEnd, 200);
            [kdeF, ~] = ksdensity(rippSpks, kdePts);
            muaKDE    = kdeF / max(kdeF);   % normalize to [0, 1]
        end

        % CoM: mean spike time within the ripple (exact center of mass
        % for a set of point masses, equivalent to the weighted mean of
        % the spike density profile)
        if ~isempty(rippSpks)
            com = mean(rippSpks);
        else
            com = nan;
        end

        % Draw order: patch (background) → KDE → peak line → CoM marker
        hold(data.hAxMua, 'on');

        % Ripple extent — shades the region whose spikes enter the KDE / CoM
        patch(data.hAxMua, [stT, enT, enT, stT], [0, 0, 1, 1], ...
            [0.85 0.85 0.85], 'EdgeColor', 'none', 'FaceAlpha', 0.5);

        % Normalized KDE curve
        if ~isempty(muaKDE)
            plot(data.hAxMua, kdePts, muaKDE, 'k', 'LineWidth', 1.5);
        end

        % SWR peak — dashed blue, aligned with panels above
        xline(data.hAxMua, pkT, '--b');

        % CoM marker — orange upward triangle on the x-axis
        if ~isnan(com)
            plot(data.hAxMua, com, 0, '^', ...
                'MarkerSize', 8, ...
                'MarkerFaceColor', [0.85, 0.33, 0.10], ...
                'MarkerEdgeColor', 'none', ...
                'Clipping', 'off');
        end

        hold(data.hAxMua, 'off');

        xlim(data.hAxMua, [winStart, winEnd]);
        ylim(data.hAxMua, [0, 1.15]);   % fixed [0, 1] + small headroom
        xlabel(data.hAxMua, 'Time (s)');
        ylabel(data.hAxMua, 'Spike Density');
        grid(data.hAxMua, 'on');


        % ---- Cache render data for ripp_gui2_export ----
        rd.tVec       = tVec;
        rd.lfpSeg     = lfpSeg;
        rd.yLimRaw    = data.yLimRaw;
        rd.spkSorted  = spkSorted;
        rd.brstSorted = brstSorted;
        rd.kdePts     = kdePts;
        rd.muaKDE     = muaKDE;
        rd.com        = com;
        rd.stT        = stT;
        rd.pkT        = pkT;
        rd.enT        = enT;
        rd.winStart   = winStart;
        rd.winEnd     = winEnd;
        rd.idx        = idx;
        data.renderData = rd;

        figH.UserData = data;
    end

    % -----------------------------------------------------------------
    % Firing Order Sort: returns a sort permutation with three priority
    % groups, each sorted ascending by time of first spike.
    %
    %   Group 1 (bottom): units with ≥1 spike within [stT, enT].
    %                     Ordered by first within-ripple spike.
    %   Group 2 (middle): units with spikes in the window but NOT in the
    %                     ripple. Ordered by first window spike.
    %   Group 3 (top):    units with no spikes in the display window.
    % -----------------------------------------------------------------
    function sortOrder = firingOrderSort(spkWin, stT, enT)
        nUnits = length(spkWin);

        firstInRipp  = inf(nUnits, 1);   % first spike within [stT, enT]
        firstOutRipp = inf(nUnits, 1);   % first spike in window outside ripple

        for k = 1 : nUnits
            s = spkWin{k};
            if isempty(s), continue; end
            sIn  = s(s >= stT & s <= enT);
            sOut = s(s <  stT | s >  enT);
            if ~isempty(sIn),  firstInRipp(k)  = min(sIn);  end
            if ~isempty(sOut), firstOutRipp(k) = min(sOut); end
        end

        % Group membership
        idxIn  = ~isinf(firstInRipp);
        idxOut =  isinf(firstInRipp) & ~isinf(firstOutRipp);
        idxSil =  isinf(firstInRipp) &  isinf(firstOutRipp);

        % Sort within each group
        [~, ordIn]  = sort(firstInRipp(idxIn),   'ascend');
        [~, ordOut] = sort(firstOutRipp(idxOut),  'ascend');

        grpIn  = find(idxIn);  grpIn  = grpIn(ordIn);
        grpOut = find(idxOut); grpOut = grpOut(ordOut);
        grpSil = find(idxSil);

        sortOrder = [grpIn; grpOut; grpSil];
    end

end     % EOF
